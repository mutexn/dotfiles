
# テーマ設定
theme = TokyoNight

# フォント。1 行に 1 つずつ書くと、上から順に使われる（カンマ区切りは 1 つの名前として扱われる）
# 英数字は Nerd Font、日本語はヒラギノ角ゴ
font-family = "BlexMono Nerd Font Mono"
font-family = "Hiragino Sans"

# 起動時の作業ディレクトリ
working-directory = ~/Dev

# ウィンドウ内の余白
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true

# クイックターミナルの設定ｗ
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-autohide = true

# グローバルキーバインド
keybind = global:ctrl+@=toggle_quick_terminal

# 非アクティブペインを暗く
unfocused-split-opacity = 0.7

# SSH 先で TERM が壊れないようにする（docs/terminal-and-input.md）
# xterm-ghostty の定義は Ghostty.app の中にしかなく、ssh は TERM しか送らない。
# ssh-terminfo が接続先に定義を転送し、失敗したら ssh-env が xterm-256color に落とす
shell-integration-features = ssh-env,ssh-terminfo

# タイトルバーの描画方式。macOS ネイティブのタブバーに任せる
# （tabs は Ghostty の自前描画で、macOS 27 ではタブ名が空欄や "..." になる）
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden

# デスクトップ通知
desktop-notifications = true