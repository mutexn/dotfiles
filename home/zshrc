# ~/.config/zsh/.zshrc — 対話シェル起動時に読まれる。詳細は docs/zsh.md

# コマンド履歴の保存先。macOS 標準の /etc/zshrc が ~/.zsh_history を指定するので、ここで上書きする
HISTFILE="$XDG_STATE_HOME/zsh/history"
[[ -d "${HISTFILE:h}" ]] || mkdir -p "${HISTFILE:h}"

export PATH="$HOME/.local/bin:$PATH"

# プロンプト: starship。見た目は ~/.config/starship.toml（config/starship.toml）で設定する（docs/zsh.md）
(( $+commands[starship] )) && eval "$(starship init zsh)"

# ls の色付き・種別記号付き表示
alias ls='ls -GF'
alias ll='ls -lGFh'
alias la='ls -aGF'

# direnv: ディレクトリごとの .envrc を自動で読み込む
eval "$(direnv hook zsh)"

# LM Studio CLI (lms)
export PATH="$PATH:$HOME/.lmstudio/bin"

# pnpm（standalone 版）。"# pnpm" と "# pnpm end" は pnpm setup が既存ブロックを見分ける目印なので変えない
# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# mise: Node などのランタイムを cd に合わせて切り替える。PATH の先頭を取るため最後の方で有効化する
eval "$(mise activate zsh)"

# --- モダン CLI（docs/cli-tools.md）。入っているものだけ有効にする ---
# zsh-autosuggestions: 過去の履歴から入力候補を薄く表示。→ キーで確定
[[ -r "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# fzf: ctrl+r で履歴、ctrl+t でファイル、alt+c でフォルダを、あいまい検索で選ぶ
if (( $+commands[fzf] )); then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
  source <(fzf --zsh)
fi

# zoxide: よく行くフォルダを覚える。z キーワード で移動、zi で一覧から選ぶ
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# delta: git の差分を色付き・行番号付きで表示
(( $+commands[delta] )) && export GIT_PAGER=delta

# eza: 既存の ls / ll / la は変えず、別名で使う
if (( $+commands[eza] )); then
  alias le='eza -la --git --group-directories-first --icons'   # 一覧 + git の状態
  alias lt='eza --tree --level=2 --git-ignore --icons'          # フォルダ構造をツリー表示
fi

# マシン固有の設定・秘密情報（トークン等）。リポジトリには含めない
[[ ! -f "$ZDOTDIR/local.zsh" ]] || source "$ZDOTDIR/local.zsh"
